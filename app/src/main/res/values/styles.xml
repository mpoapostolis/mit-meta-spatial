<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Transparent platform theme so the Compose layer's own background (drawn in
         InfoPanel.kt) is what the user sees. Without this, the panel renders on top of
         the default opaque Activity window. -->
    <style name="PanelAppThemeTransparent" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
