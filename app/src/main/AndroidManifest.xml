<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <!-- Meta Horizon OS target -->
    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="69" />

    <!-- Quest 2/3/3S/Pro VR features -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <!-- Passthrough + virtual keyboard extensions (declared by SDK samples) -->
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-feature android:name="com.oculus.feature.VIRTUAL_KEYBOARD" android:required="false" />
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />

    <!-- Network for PocketBase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      No application-level theme: Spatial SDK injects its own panel theme via
      PanelStyleOptions(themeResourceId = ...). Setting an opaque application theme
      (Theme.Black.NoTitleBar.Fullscreen) caused panel surfaces to render with a black
      opaque background instead of the Compose content — fixed by dropping it.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <!-- Quest device whitelist -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|quest3|quest3s|questpro" />

        <meta-data android:name="com.oculus.handtracking.frequency" android:value="HIGH" />
        <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />

        <!-- Required for VR input focus + Spatial SDK panel rendering -->
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <uses-native-library
            android:name="libossdk.oculus.so"
            android:required="true" />

        <!--
          configChanges include uiMode (StarterSample) so detachable-keyboard / dark-mode
          changes don't recreate the activity (which would destroy panel entities mid-frame).
          No screenOrientation lock — Quest activities are 6DoF, locking landscape is invalid
          and was likely interfering with the panel surface composition pipeline.
        -->
        <activity
            android:name=".ImmersiveActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode"
            android:resizeableActivity="false">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Appears in Quest VR launcher -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>

            <!-- Optional: read exhibition id from URL → adb shell am start -a android.intent.action.VIEW -d "museum://exhibit/abc123" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="museum" android:host="exhibit" />
            </intent-filter>
        </activity>
    </application>
</manifest>
